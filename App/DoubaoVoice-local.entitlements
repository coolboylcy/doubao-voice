<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  本地 DMG 版专用：与商店版的区别只有一条——不开 App Sandbox。

  沙盒会禁掉 System V 信号量（semctl），而 PyInstaller 的 onefile bootloader
  启动时必须建一个，于是内置 ASR helper 一起来就死在
  「Failed to initialize sync semaphore / Operation not permitted」，
  录音链路整条起不来，外部表现是按下右 Option 毫无反应。

  商店版仍用 App/DoubaoVoice.entitlements（带 sandbox），由
  scripts/archive-app-store.sh 走，不受此文件影响。
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
